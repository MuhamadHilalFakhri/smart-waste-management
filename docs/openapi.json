{
  "openapi": "3.0.3",
  "info": {
    "title": "Smart Waste API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/register": {
      "post": {
        "summary": "Daftar pengguna",
        "responses": {
          "201": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password",
                  "password_confirmation"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "password_confirmation": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Login",
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/logout": {
      "post": {
        "summary": "Logout",
        "responses": {
          "204": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Profil",
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard": {
      "get": {
        "summary": "Statistik",
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reports": {
      "get": {
        "summary": "Daftar laporan",
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "summary": "Buat laporan",
        "responses": {
          "201": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ReportInput"
              }
            }
          }
        }
      }
    },
    "/reports/{id}": {
      "get": {
        "summary": "Detail laporan",
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      },
      "put": {
        "summary": "Ubah laporan",
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ReportInput"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Hapus laporan",
        "responses": {
          "204": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/reports/{id}/photo": {
      "get": {
        "summary": "Foto privat",
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/reports/{id}/predict": {
      "post": {
        "summary": "Ulangi prediksi",
        "responses": {
          "202": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/reports/{id}/status": {
      "patch": {
        "summary": "Ubah status oleh Admin",
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "in_progress",
                      "completed",
                      "rejected"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "description": "Wajib untuk rejected"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ReportInput": {
        "type": "object",
        "required": [
          "description",
          "latitude",
          "longitude",
          "photo"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 5000
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "category": {
            "type": "string",
            "enum": [
              "organic",
              "paper",
              "plastic"
            ]
          },
          "photo": {
            "type": "string",
            "format": "binary",
            "description": "JPEG/PNG/WebP, maksimal 5 MB"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}