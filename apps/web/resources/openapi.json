            }
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "404": {
            "description": "Tidak ditemukan"
          },
          "429": {
            "description": "Batas permintaan terlampaui"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      },
      "put": {
        "summary": "Ubah laporan",
        "responses": {
          "200": {
            "description": "Berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "404": {
            "description": "Tidak ditemukan"
          },
          "429": {
            "description": "Batas permintaan terlampaui"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ReportUpdate"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Hapus laporan",
        "responses": {
          "204": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Tidak login"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "422": {
            "description": "Validasi gagal",
            "content": {
              "application/json": {
