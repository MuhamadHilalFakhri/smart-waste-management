          "404": {
            "description": "Tidak ditemukan"
          },
          "429": {
            "description": "Batas permintaan terlampaui"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ReportInput"
              }
            }
          }
        }
      }
    },
    "/reports/{id}": {
      "get": {
        "summary": "Detail laporan",
        "responses": {
          "200": {
            "description": "Berhasil",
            "content": {
              "application/json": {
