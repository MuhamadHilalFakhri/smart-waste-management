{
  "expo": {
    "name": "Smart Waste",
    "slug": "smart-waste-management",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 3,
      "package": "com.smartwaste.management",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Pilih foto sampah untuk laporan.",
          "cameraPermission": "Ambil foto sampah untuk laporan.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Catat koordinat laporan sampah."
        }
      ],
      "expo-secure-store",
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9bc93050-ee16-41c9-81a4-cf2ffad7cbc4"
      }
    },
    "owner": "maykiddd",
    "scheme": "smartwaste"
  }
}
